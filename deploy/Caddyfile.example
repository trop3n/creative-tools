# Static hosting for the suite. Copy dist/ to /srv/creative-tools on the host.
# Every tool is a single index.html, so no rewrites are needed; the trailing-slash
# redirect keeps relative asset paths working.
:80 {
	root * /srv/creative-tools
	encode zstd gzip
	file_server
	header /*.html Cache-Control "no-cache"
}
# HTTPS on the tailnet (needed for webcam and clipboard), on the host:
#   tailscale serve --bg http://localhost:80
